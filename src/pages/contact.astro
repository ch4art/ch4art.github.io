---
import BaseLayout from '../layouts/BaseLayout.astro';

// ===== 設定:把下面兩個換成你自己的(都免費) =====
// 1) Web3Forms access key — 到 https://web3forms.com 輸入你的 email 免費取得(可安全放在前端)
const WEB3FORMS_KEY = 'YOUR_WEB3FORMS_ACCESS_KEY';
// 2) 預約連結 — Calendly(https://calendly.com)或 Cal.com 的 inline 連結;留空則先不顯示日曆
//    例:'https://calendly.com/你的帳號/30min'
const CALENDLY_URL = '';
---

<BaseLayout title="合作邀約" description="想找我做 3D、插畫或合作?留個訊息或直接預約一通電話。">
  <h1 class="sticker title-pop text-5xl mb-3">合作邀約 💌</h1>
  <p class="text-ink/80 font-bold mb-8">
    想找我做 3D / 插畫 / 商業合作?留個訊息,或直接預約一通電話 ☎️
  </p>

  <div class="grid gap-8 md:grid-cols-2 items-start">
    <!-- ===== 留言表單 ===== -->
    <section class="card-pop p-6">
      <h2 class="font-display text-2xl text-bubblegum-deep mb-4">留訊息給我 ✏️</h2>
      <form id="contact-form" class="contact-form">
        <input type="hidden" name="access_key" value={WEB3FORMS_KEY} />
        <input type="hidden" name="subject" value="網站合作邀約 💌" />
        <input type="checkbox" name="botcheck" class="hidden" style="display:none" tabindex="-1" autocomplete="off" />
        <label>
          你的名字
          <input name="name" required placeholder="怎麼稱呼你?" />
        </label>
        <label>
          你的 Email
          <input type="email" name="email" required placeholder="我回信的地方" />
        </label>
        <label>
          主旨 / 公司(可留空)
          <input name="company" placeholder="例如:某某公司 / 想做一個吉祥物" />
        </label>
        <label>
          訊息
          <textarea name="message" rows="5" required placeholder="想做什麼?預算 / 時程 大概是?"></textarea>
        </label>
        <button
          type="submit"
          class="btn-pop anim-wiggle bg-bubblegum text-ink text-lg px-7 py-3 mt-2 self-start"
        >
          送出 🚀
        </button>
        <p id="form-status" class="form-status" role="status" aria-live="polite"></p>
      </form>
    </section>

    <!-- ===== 預約日曆 ===== -->
    <section class="card-pop p-6">
      <h2 class="font-display text-2xl text-bubblegum-deep mb-4">預約一通電話 ☎️</h2>
      {
        CALENDLY_URL ? (
          <>
            <div
              class="calendly-inline-widget"
              data-url={CALENDLY_URL}
              style="min-width:280px;height:640px;"
            />
            <script is:inline src="https://assets.calendly.com/assets/external/widget.js" async />
          </>
        ) : (
          <div class="text-ink/70 leading-relaxed">
            <p class="mb-3">還沒設定預約日曆 🗓️</p>
            <p class="text-sm">
              到 <strong>Calendly</strong> 或 <strong>Cal.com</strong> 開個免費帳號、設好你的有空時段,
              把預約連結貼進 <code>src/pages/contact.astro</code> 的 <code>CALENDLY_URL</code>,
              這裡就會出現一個讓對方挑時段的日曆。
            </p>
          </div>
        )
      }
    </section>
  </div>
</BaseLayout>

<script>
  function setupContactForm() {
    const form = document.getElementById('contact-form') as HTMLFormElement | null;
    const status = document.getElementById('form-status');
    if (!form || !status || form.dataset.bound) return;
    form.dataset.bound = 'true';

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      status.textContent = '送出中…';
      const data = Object.fromEntries(new FormData(form));
      if (String(data.access_key).startsWith('YOUR_')) {
        status.textContent = '⚠️ 表單還沒設定(請先填好 Web3Forms 的 access key)。';
        return;
      }
      try {
        const res = await fetch('https://api.web3forms.com/submit', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
          body: JSON.stringify(data),
        });
        const json = await res.json();
        if (json.success) {
          form.reset();
          status.textContent = '✅ 收到了!我會盡快回你 💖';
        } else {
          status.textContent = '⚠️ 送出失敗:' + (json.message || '請稍後再試');
        }
      } catch {
        status.textContent = '⚠️ 網路錯誤,請稍後再試。';
      }
    });
  }

  setupContactForm();
  document.addEventListener('astro:page-load', setupContactForm);
</script>
