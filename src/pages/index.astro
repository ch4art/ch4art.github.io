---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import LazyModelViewer from '../components/three/LazyModelViewer.tsx';
import SectionTitle from '../components/SectionTitle.astro';
import BlobFrame from '../components/decor/BlobFrame.astro';
import RotatingBadge from '../components/decor/RotatingBadge.astro';
import SpeechBubble from '../components/decor/SpeechBubble.astro';
import ScallopDivider from '../components/decor/ScallopDivider.astro';
import PolaroidFrame from '../components/decor/PolaroidFrame.astro';
import { modelUrl } from '../lib/model';
import { withBase } from '../lib/withBase';
import { latestDrawings, latestPosts } from '../lib/feed';

const drawings = await latestDrawings(3);
const posts = await latestPosts(4);

// 門廊拍立得的扇形角度(確定性,SSG 穩定)
const fan = [-8, -1, 7];
---

<BaseLayout title="ch4art — 可愛的畫畫與 3D 模型" fullBleed>
  <!-- ===== HERO:貼紙書桌(滿幅色塊,鴨鴨溢出邊界) ===== -->
  <section class="hero relative">
    <div class="mx-auto grid max-w-6xl items-center gap-10 px-4 pb-10 pt-10 md:grid-cols-12 md:pb-4 md:pt-14">
      <div class="relative z-10 text-center md:col-span-7 md:text-left">
        <h1
          class="title-pop title-pop-hero sticker text-hero"
          data-text="嗨,我是 ch4art!"
          data-hero-title
        >
          嗨,我是 ch4art!
        </h1>
        <p class="mx-auto mt-6 max-w-md font-bold leading-relaxed text-outline md:mx-0" data-hero-sub>
          把腦袋裡的小可愛<strong>畫下來</strong>、<strong>捏成 3D</strong>。
          這裡放我的畫、模型,還有做東西時的碎碎念。
        </p>
      </div>

      <div class="relative z-10 md:col-span-5" data-hero-model>
        <!-- 鴨鴨溢出 hero 下緣,壓在扇貝分隔線上 -->
        <div class="relative mx-auto max-w-sm translate-y-8 md:translate-y-14">
          <BlobFrame color="#F4EEFF">
            <!-- client:only 在 hydrate 前是空的 —— 外層固定高度防 CLS;
                 poster 放在靜態 background-image,首繪就到位(LCP) -->
            <div
              style={`height:380px;background:#F4EEFF url('${withBase('works/mouse-poster.webp')}') center/contain no-repeat;`}
            >
              <LazyModelViewer
                client:only="react"
                src={modelUrl('mouse.glb')}
                environment="studio"
                height="100%"
                background="#F4EEFF"
                poster={withBase('works/mouse-poster.webp')}
              />
            </div>
          </BlobFrame>
          <div class="absolute -right-6 -top-8 hidden sm:block" data-hero-badge>
            <RotatingBadge text="CH4ART • 2D × 3D • CUTE" size={110} color="var(--color-outline)">
              🐭
            </RotatingBadge>
          </div>
          <div class="absolute -left-4 -top-6" data-hero-bubble>
            <SpeechBubble tail="bottom-right" tilt={-4}>可以拖我旋轉!</SpeechBubble>
          </div>
        </div>
      </div>
    </div>

    <!-- hero 內錨定的 Memphis 形狀(跟著色塊走,不在視差層) -->
    <span class="hero-shape" style="top:14%;left:4%;color:#fff;" aria-hidden="true">
      <svg width="52" height="52" viewBox="0 0 100 100" fill="currentColor"><path d="M50 4 C56 38 62 44 96 50 C62 56 56 62 50 96 C44 62 38 56 4 50 C38 44 44 38 50 4 Z"></path></svg>
    </span>
    <span class="hero-shape" style="top:62%;left:8%;color:var(--color-butter);" aria-hidden="true">
      <svg width="40" height="40" viewBox="0 0 100 100" fill="none" stroke="currentColor" stroke-width="12"><circle cx="50" cy="50" r="40"></circle></svg>
    </span>
    <span class="hero-shape" style="top:10%;right:6%;color:#fff;" aria-hidden="true">
      <svg width="84" height="22" viewBox="0 0 100 24" fill="none" stroke="currentColor" stroke-width="7" stroke-linecap="round"><path d="M3 12 Q 15 1 27 12 T 51 12 T 75 12 T 99 12"></path></svg>
    </span>
  </section>
  <ScallopDivider color="var(--color-bubblegum)" size={22} />

  <!-- ===== 雙門廊:今天想看哪一種? ===== -->
  <section class="mx-auto mt-16 max-w-6xl px-4">
    <SectionTitle text="今天想看哪一種?" emoji="✨" class="sticker" />
    <div class="mt-8 grid gap-6 lg:grid-cols-5">
      <!-- 2D 門:拍立得扇形堆 -->
      <a
        href={withBase('gallery-2d')}
        class="door group block rounded-[2.5rem] border-[3px] border-outline bg-pink-mist p-7 shadow-pop lg:col-span-3"
        data-door="2d"
      >
        <div class="flex items-baseline justify-between gap-3">
          <h3 class="title-pop text-3xl md:text-4xl" data-text="畫畫的">畫畫的</h3>
          <span class="btn-pop bg-bubblegum px-4 py-1.5 text-sm text-ink">進畫廊 →</span>
        </div>
        <div class="fan relative mt-6 h-56 sm:h-64">
          {
            drawings.map((d, i) => (
              <div
                class="fan-item absolute"
                style={`left:${10 + i * 26}%;top:${8 + (i % 2) * 8}%;z-index:${i};`}
              >
                <PolaroidFrame caption={d.data.title} tilt={fan[i % fan.length]} tape={i !== 1}>
                  <Image
                    src={d.data.image}
                    alt={d.data.alt}
                    width={240}
                    widths={[240, 480]}
                    sizes="240px"
                    class="fan-img"
                  />
                </PolaroidFrame>
              </div>
            ))
          }
          {drawings.length === 0 && <p class="pt-10 text-center font-bold text-ink/60">畫作整理中 🖍️</p>}
        </div>
      </a>

      <!-- 3D 門:玩具電視框(GIF,不開第二個 canvas) -->
      <a
        href={withBase('gallery-3d')}
        class="door group block rounded-[2.5rem] border-[3px] border-outline bg-sky-mist p-7 shadow-pop lg:col-span-2"
        data-door="3d"
      >
        <div class="flex items-baseline justify-between gap-3">
          <h3 class="title-pop text-3xl md:text-4xl" data-text="捏的模型">捏的模型</h3>
          <span class="btn-pop bg-skyberry px-4 py-1.5 text-sm text-ink">進展示間 →</span>
        </div>
        <div class="toy-tv relative mx-auto mt-8 max-w-[260px]">
          <!-- 天線 -->
          <svg class="absolute -top-7 left-1/2 -ml-9" width="72" height="30" viewBox="0 0 72 30" aria-hidden="true">
            <g stroke="var(--color-outline)" stroke-width="4" stroke-linecap="round">
              <line x1="22" y1="28" x2="8" y2="6"></line>
              <line x1="50" y1="28" x2="64" y2="6"></line>
            </g>
            <circle cx="8" cy="6" r="5" fill="var(--color-bubblegum-deep)"></circle>
            <circle cx="64" cy="6" r="5" fill="var(--color-sunshine)"></circle>
          </svg>
          <div class="overflow-hidden rounded-[1.5rem] border-[3px] border-outline bg-white p-2 shadow-pop">
            <!-- 門廊用小 webp(轉圈 GIF 留給 gallery-3d 本人) -->
            <img
              src={withBase('works/mouse-poster.webp')}
              alt="小鼠鼠 3D 模型"
              width="260"
              height="260"
              loading="lazy"
              class="w-full rounded-[1rem]"
              style="aspect-ratio:1/1;object-fit:contain;background:#FFF0F6;"
            />
          </div>
        </div>
        <p class="mt-5 text-center text-sm font-bold text-ink">每一隻都可以拖著轉圈圈</p>
      </a>
    </div>
  </section>

  <!-- ===== 最近寫的:筆記本 ===== -->
  <section class="mx-auto mt-20 max-w-4xl px-4">
    <div class="flex items-end justify-between gap-4">
      <SectionTitle text="最近寫的" emoji="✏️" class="sticker" />
      <a href={withBase('blog')} class="btn-pop bg-lavender px-4 py-2 text-sm whitespace-nowrap text-ink">全部文章 →</a>
    </div>
    <div class="notebook card-pop mt-8 overflow-hidden">
      <!-- 筆記本紅線裝訂邊 -->
      <div class="notebook-margin" aria-hidden="true"></div>
      {
        posts.length === 0 ? (
          <p class="p-10 text-center font-bold text-ink/60">還沒有文章 ✨</p>
        ) : (
          <ul class="bg-ruled px-6 py-4 pl-14" style="--ruled-gap:3rem;">
            {posts.map((post, i) => (
              <li class="flex h-12 items-center gap-3" data-anim="row">
                <span
                  class="note-dot"
                  style={`background:${['var(--color-bubblegum)', 'var(--color-skyberry)', 'var(--color-mint)', 'var(--color-butter)'][i % 4]};`}
                  aria-hidden="true"
                />
                <a
                  href={withBase(`blog/${post.id}`)}
                  class="min-w-0 flex-1 truncate font-display text-lg text-ink hover:text-bubblegum-deep hover:underline"
                >
                  {post.data.title}
                </a>
                <time class="note-date" datetime={post.data.pubDate.toISOString()}>
                  {post.data.pubDate.toLocaleDateString('zh-TW', { month: 'numeric', day: 'numeric' })}
                </time>
              </li>
            ))}
          </ul>
        )
      }
    </div>
  </section>
</BaseLayout>

<style>
  .hero {
    background: linear-gradient(
      180deg,
      var(--color-strawberry) 0%,
      var(--color-bubblegum) 100%
    );
    /* 點點覆在漸層上,跟頁面底紋呼應 */
    background-blend-mode: normal;
  }
  .hero::after {
    content: '';
    position: absolute;
    inset: 0;
    background-image: radial-gradient(rgba(255, 255, 255, 0.28) 1.7px, transparent 1.7px);
    background-size: 26px 26px;
    pointer-events: none;
  }
  .hero-shape {
    position: absolute;
    z-index: 1;
    opacity: 0.85;
    pointer-events: none;
  }

  .door {
    transition:
      transform 0.2s ease,
      box-shadow 0.2s ease;
  }
  @media (hover: hover) {
    .door:hover {
      transform: translate(-3px, -3px);
      box-shadow: var(--shadow-pop-lg);
    }
  }
  .fan-item :global(.polaroid) {
    width: clamp(120px, 16vw, 180px);
  }
  .fan :global(img.fan-img) {
    width: 100%;
    height: auto;
  }

  .notebook {
    position: relative;
  }
  .notebook-margin {
    position: absolute;
    top: 0;
    bottom: 0;
    left: 2.5rem;
    width: 3px;
    background: var(--color-coral);
    opacity: 0.7;
  }
  .note-dot {
    width: 14px;
    height: 14px;
    flex: none;
    border: 2.5px solid var(--color-outline);
    border-radius: 50%;
  }
  .note-date {
    flex: none;
    font-family: var(--font-label);
    font-weight: 700;
    font-size: 0.8rem;
    color: var(--color-ink);
    border: 2px dashed var(--color-bubblegum-deep);
    border-radius: 9999px;
    padding: 2px 10px;
    transform: rotate(3deg);
  }
</style>
