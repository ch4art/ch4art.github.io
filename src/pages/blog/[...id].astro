---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection, render } from 'astro:content';
import { Image } from 'astro:assets';
import { withBase } from '../../lib/withBase';

export async function getStaticPaths() {
  const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
    (a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime(),
  );
  return posts.map((post, i) => ({
    params: { id: post.id },
    props: {
      post,
      newer: i > 0 ? posts[i - 1] : null,
      older: i < posts.length - 1 ? posts[i + 1] : null,
    },
  }));
}

const { post, newer, older } = Astro.props;
const { Content } = await render(post);
---

<BaseLayout title={post.data.title} description={post.data.description}>
  <article class="mx-auto max-w-3xl">
    <a href={withBase('blog')} class="btn-pop bg-skyberry text-ink text-sm px-4 py-1.5">← 回部落格</a>
    <h1 class="sticker title-pop text-4xl mt-5">{post.data.title}</h1>
    <p class="text-ink/60 font-bold mt-2">{post.data.pubDate.toLocaleDateString('zh-TW')}</p>

    {
      post.data.tags.length > 0 && (
        <ul class="flex flex-wrap gap-2 mt-3">
          {post.data.tags.map((t) => (
            <li>
              <a
                href={withBase(`blog/tag/${t}`)}
                class="inline-block text-xs font-bold px-3 py-1 rounded-pill bg-lavender text-ink border-2 border-outline hover:bg-bubblegum hover:text-white transition-colors"
              >
                #{t}
              </a>
            </li>
          ))}
        </ul>
      )
    }

    {
      post.data.heroImage && (
        <Image
          src={post.data.heroImage}
          alt={post.data.heroImageAlt ?? ''}
          class="rounded-blob shadow-soft my-5 w-full h-auto"
        />
      )
    }

    <div class="post-body mt-5">
      <Content />
    </div>

    {
      (newer || older) && (
        <nav class="flex justify-between gap-3 mt-12">
          {older ? (
            <a
              href={withBase(`blog/${older.id}`)}
              class="btn-pop bg-butter text-ink text-sm px-4 py-2 max-w-[46%]"
            >
              ← 較舊:{older.data.title}
            </a>
          ) : (
            <span />
          )}
          {newer ? (
            <a
              href={withBase(`blog/${newer.id}`)}
              class="btn-pop bg-mint text-ink text-sm px-4 py-2 max-w-[46%] text-right"
            >
              較新:{newer.data.title} →
            </a>
          ) : (
            <span />
          )}
        </nav>
      )
    }
  </article>
</BaseLayout>
