---
// 文章頁:mist 色帶頭 + 糖果條紋閱讀進度條 + 文末「看完啦」橡皮章 +
// 行李吊牌前後導覽。私密文 AES-GCM 解鎖 script 原樣沿用 v1(契約勿動)。
import BaseLayout from '../../layouts/BaseLayout.astro';
import StampSeal from '../../components/decor/StampSeal.astro';
import { getCollection, render } from 'astro:content';
import { Image } from 'astro:assets';
import { withBase } from '../../lib/withBase';

export async function getStaticPaths() {
  const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
    (a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime(),
  );
  return posts.map((post, i) => ({
    params: { id: post.id },
    props: {
      post,
      newer: i > 0 ? posts[i - 1] : null,
      older: i < posts.length - 1 ? posts[i + 1] : null,
    },
  }));
}

const { post, newer, older } = Astro.props;
const { Content } = await render(post);
---

<BaseLayout
  title={`${post.data.title} — ch4art`}
  description={post.data.description}
  ogImage={post.data.heroImage?.src}
>
  <!-- 閱讀進度:糖果條紋,GSAP scrub 驅動(motion.ts) -->
  <div class="read-progress bg-candy-stripe" data-read-progress aria-hidden="true"></div>

  <article class="mx-auto max-w-3xl">
    <!-- mist 色帶頭 -->
    <header class="head-band relative">
      <a href={withBase('blog')} class="btn-pop bg-skyberry px-4 py-1.5 text-sm text-ink">← 回部落格</a>
      <h1 class="sticker title-pop mt-5 text-4xl md:text-5xl" data-text={post.data.title}>
        {post.data.title}
      </h1>
      <time class="postmark" datetime={post.data.pubDate.toISOString()}>
        <span>{post.data.pubDate.toLocaleDateString('zh-TW', { month: 'numeric', day: 'numeric' })}</span>
        <span class="postmark-y">{post.data.pubDate.getFullYear()}</span>
      </time>

      {
        post.data.tags.length > 0 && (
          <ul class="mt-4 flex flex-wrap gap-2">
            {post.data.tags.map((t, i) => (
              <li>
                <a
                  href={withBase(`blog/tag/${t}`)}
                  class="inline-block rounded-pill border-2 border-outline bg-white px-3 py-1 text-xs font-bold text-ink transition-colors hover:bg-bubblegum hover:text-white"
                  style={`transform:rotate(${i % 2 === 0 ? -1.5 : 1.5}deg);`}
                >
                  #{t}
                </a>
              </li>
            ))}
          </ul>
        )
      }
    </header>

    {
      post.data.heroImage && (
        <Image
          src={post.data.heroImage}
          alt={post.data.heroImageAlt ?? ''}
          class="rounded-blob shadow-soft my-6 h-auto w-full"
        />
      )
    }

    {
      post.data.private && post.data.cipher ? (
        <div class="post-body mt-6" id="private-root" data-cipher={post.data.cipher}>
          <div class="lockbox" id="lockbox">
            <div class="lock-emoji">🔒</div>
            <p class="font-bold">這是一篇私密文章,輸入通關密語才能看喔</p>
            <form id="lock-form" autocomplete="off">
              <input
                id="lock-pw"
                type="password"
                placeholder="通關密語…"
                autocomplete="off"
                required
              />
              <button id="lock-btn" class="btn-pop bg-bubblegum text-white px-5 py-2" type="submit">
                解鎖 ✨
              </button>
            </form>
            <p class="lock-err" id="lock-err" hidden>
              密語不對喔,再試一次 🥺
            </p>
          </div>
        </div>
      ) : (
        <div class="post-body mt-6">
          <Content />
        </div>
      )
    }

    <script>
      // 私密文章解鎖:密語 → PBKDF2 → AES-GCM 解密,全部在瀏覽器裡完成。
      // 網站(和 GitHub)上只有密文;密語不會被傳送或儲存到任何伺服器。
      const b64d = (s: string) => Uint8Array.from(atob(s), (c) => c.charCodeAt(0));

      // 密語正規化:NFC + 去頭尾空白,跟編輯器端一致(避免中文/emoji 或多打
      // 一個空白就永遠解不開)。
      const normPw = (s: string): string => s.normalize('NFC').trim();

      // 解出來的金鑰只放在記憶體裡(撐過 ClientRouter 換頁,整頁重整就消失)。
      // 比把密語塞進 sessionStorage 安全:磁碟/其他腳本都讀不到密語。
      const keyCache = new Map<string, CryptoKey>();

      class WrongPassword extends Error {}

      async function deriveKey(pw: string, salt: Uint8Array, iter: number): Promise<CryptoKey> {
        const material = await crypto.subtle.importKey(
          'raw',
          new TextEncoder().encode(normPw(pw)),
          'PBKDF2',
          false,
          ['deriveKey'],
        );
        return crypto.subtle.deriveKey(
          { name: 'PBKDF2', salt: salt as BufferSource, iterations: iter, hash: 'SHA-256' },
          material,
          { name: 'AES-GCM', length: 256 },
          false,
          ['decrypt'],
        );
      }

      async function render(root: HTMLElement, key: CryptoKey): Promise<void> {
        const env = JSON.parse(atob(root.dataset.cipher || ''));
        let pt: ArrayBuffer;
        try {
          pt = await crypto.subtle.decrypt(
            { name: 'AES-GCM', iv: b64d(env.iv) as BufferSource },
            key,
            b64d(env.ct) as BufferSource,
          );
        } catch {
          throw new WrongPassword(); // GCM 認證失敗 = 密語不對
        }
        const payload = JSON.parse(new TextDecoder().decode(pt));
        const { marked } = await import('marked');
        let html = marked.parse(payload.md || '') as string;
        for (const im of payload.images || []) {
          // 圖片下載失敗(網路問題)不該被當成密語錯誤;解密失敗才略過該張。
          const res = await fetch(`${import.meta.env.BASE_URL}${im.file}`);
          const ct = new Uint8Array(await res.arrayBuffer());
          try {
            const bytes = await crypto.subtle.decrypt(
              { name: 'AES-GCM', iv: b64d(im.iv) as BufferSource },
              key,
              ct as BufferSource,
            );
            const url = URL.createObjectURL(new Blob([bytes], { type: im.type || 'image/png' }));
            html = html.split(`./images/${im.name}`).join(url);
          } catch {
            /* 單張圖片解不開不擋整篇 */
          }
        }
        keyCache.set(location.pathname, key);
        root.innerHTML = html;
      }

      async function unlock(root: HTMLElement, pw: string): Promise<void> {
        const env = JSON.parse(atob(root.dataset.cipher || ''));
        const key = await deriveKey(pw, b64d(env.salt), env.iter || 310000);
        await render(root, key);
      }

      function setup(): void {
        const root = document.getElementById('private-root');
        if (!root || root.dataset.bound) return;
        root.dataset.bound = '1';
        const form = root.querySelector('#lock-form') as HTMLFormElement;
        const input = root.querySelector('#lock-pw') as HTMLInputElement;
        const btn = root.querySelector('#lock-btn') as HTMLButtonElement;
        const err = root.querySelector('#lock-err') as HTMLElement;
        const box = root.querySelector('#lockbox') as HTMLElement;

        const fail = (msg: string): void => {
          err.textContent = msg;
          err.hidden = false;
          box.classList.remove('lock-shake');
          void box.offsetWidth; // 重新觸發動畫
          box.classList.add('lock-shake');
        };

        form.addEventListener('submit', async (e) => {
          e.preventDefault();
          if (btn.disabled) return;
          err.hidden = true;
          btn.disabled = true;
          btn.textContent = '解鎖中…';
          try {
            await unlock(root, input.value);
          } catch (ex) {
            if (ex instanceof WrongPassword) fail('密語不對喔,再試一次 🥺');
            else fail('解鎖時網路怪怪的,請再按一次 🌧️');
          } finally {
            btn.disabled = false;
            btn.textContent = '解鎖 ✨';
          }
        });

        // 同一個 SPA session 內解過就直接還原(金鑰在記憶體裡)
        const cached = keyCache.get(location.pathname);
        if (cached) render(root, cached).catch(() => keyCache.delete(location.pathname));
      }

      setup();
      document.addEventListener('astro:page-load', setup);
    </script>

    <!-- 文末橡皮章(GSAP 在捲到底時砸下來) -->
    <div class="mt-12 text-center">
      <StampSeal text="看完啦 ✦" />
    </div>

    {
      (newer || older) && (
        <nav class="mt-10 grid gap-4 sm:grid-cols-2" aria-label="前後文章">
          {older ? (
            <a href={withBase(`blog/${older.id}`)} class="card-pop anim-wiggle block p-4">
              <span class="text-xs font-bold text-ink/55">← 較舊</span>
              <p class="font-display text-lg text-ink">{older.data.title}</p>
            </a>
          ) : (
            <span />
          )}
          {newer ? (
            <a href={withBase(`blog/${newer.id}`)} class="card-pop anim-wiggle block p-4 text-right">
              <span class="text-xs font-bold text-ink/55">較新 →</span>
              <p class="font-display text-lg text-ink">{newer.data.title}</p>
            </a>
          ) : (
            <span />
          )}
        </nav>
      )
    }
  </article>
</BaseLayout>

<style>
  .read-progress {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    height: 8px;
    z-index: 40;
    transform: scaleX(0);
    transform-origin: left;
    border-bottom: 2px solid var(--color-outline);
  }

  .head-band {
    background: var(--color-pink-mist);
    border: 3px solid var(--color-outline);
    border-radius: var(--radius-scoop);
    box-shadow: var(--shadow-pop);
    padding: 1.5rem 1.5rem 1.6rem;
  }

  .postmark {
    position: absolute;
    top: -16px;
    right: 18px;
    width: 68px;
    height: 68px;
    display: grid;
    place-content: center;
    text-align: center;
    background: #fff;
    border: 2.5px dashed var(--color-bubblegum-deep);
    border-radius: 50%;
    transform: rotate(8deg);
    font-family: var(--font-label);
    font-weight: 700;
    font-size: 0.85rem;
    line-height: 1.1;
    color: var(--color-bubblegum-deep);
    box-shadow: 0 0 0 3px #fff;
  }
  .postmark-y {
    font-size: 0.64rem;
    opacity: 0.75;
  }
</style>
