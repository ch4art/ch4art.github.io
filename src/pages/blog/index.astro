---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { withBase } from '../../lib/withBase';

const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime(),
);
---

<BaseLayout title="部落格">
  <h1 class="sticker title-pop text-5xl mb-7">部落格 ✏️</h1>

  {
    posts.length === 0 ? (
      <div class="card-pop p-8 text-center font-bold text-ink/70">還沒有文章,敬請期待 ✨</div>
    ) : (
      <ul class="grid gap-6 sm:grid-cols-2">
        {posts.map((post) => (
          <li class="card-pop anim-wiggle p-5 transition-transform hover:-translate-y-1">
            <a
              href={withBase(`blog/${post.id}`)}
              class="font-display text-xl text-ink hover:text-bubblegum-deep"
            >
              {post.data.title}
            </a>
            <p class="text-sm text-ink/60 font-bold mt-1">
              {post.data.pubDate.toLocaleDateString('zh-TW')}
            </p>
            <p class="mt-2 text-sm">{post.data.description}</p>
            {post.data.tags.length > 0 && (
              <ul class="flex flex-wrap gap-2 mt-4">
                {post.data.tags.map((t) => (
                  <li class="text-xs font-bold px-3 py-1 rounded-pill bg-lavender text-ink border-2 border-outline">
                    #{t}
                  </li>
                ))}
              </ul>
            )}
          </li>
        ))}
      </ul>
    )
  }
</BaseLayout>
