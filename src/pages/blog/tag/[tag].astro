---
// 標籤頁:便利貼風(跟部落格索引一致),但不重排時間軸,單欄即可。
import BaseLayout from '../../../layouts/BaseLayout.astro';
import WashiTape from '../../../components/decor/WashiTape.astro';
import { getCollection } from 'astro:content';
import { withBase } from '../../../lib/withBase';

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => !data.draft);
  const tags = [...new Set(posts.flatMap((p) => p.data.tags))];
  return tags.map((tag) => ({
    params: { tag },
    props: {
      tag,
      posts: posts
        .filter((p) => p.data.tags.includes(tag))
        .sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime()),
    },
  }));
}

const { tag, posts } = Astro.props;
const noteColors = ['var(--color-butter)', 'var(--color-lavender)', 'var(--color-mint)'];
const tapeColors = ['var(--color-bubblegum)', 'var(--color-aqua)', 'var(--color-sunshine)'];
---

<BaseLayout title={`#${tag} 的文章 — ch4art`}>
  <a href={withBase('blog')} class="btn-pop bg-skyberry px-4 py-1.5 text-sm text-ink">← 回部落格</a>
  <h1 class="sticker title-pop mb-8 mt-5 text-5xl" data-text={`#${tag}`}>#{tag}</h1>

  <ul class="mx-auto grid max-w-2xl gap-8">
    {
      posts.map((post, i) => (
        <li
          class="tag-note relative"
          style={`--note-c:${noteColors[i % 3]};--note-tilt:${i % 2 === 0 ? -1.2 : 1.4}deg;`}
        >
          <WashiTape color={tapeColors[i % 3]} tilt={i % 2 === 0 ? -7 : 6} />
          <a href={withBase(`blog/${post.id}`)} class="note-title">
            {post.data.private && '🔒 '}
            {post.data.title}
          </a>
          <p class="mt-1 text-sm font-bold text-ink/85">{post.data.pubDate.toLocaleDateString('zh-TW')}</p>
          <p class="mt-2 text-sm font-semibold text-ink">{post.data.description}</p>
        </li>
      ))
    }
  </ul>
</BaseLayout>

<style>
  .tag-note {
    background: var(--note-c);
    border: 3px solid var(--color-outline);
    border-radius: var(--radius-soft);
    box-shadow: var(--shadow-pop);
    padding: 1.4rem 1.2rem 1.1rem;
    transform: rotate(var(--note-tilt, 0deg));
    transition:
      transform 0.22s cubic-bezier(0.34, 1.56, 0.64, 1),
      box-shadow 0.22s ease;
  }
  @media (hover: hover) {
    .tag-note:hover {
      transform: rotate(0deg) translateY(-4px);
      box-shadow: var(--shadow-pop-lg);
    }
  }
  .note-title {
    font-family: var(--font-display);
    font-size: 1.25rem;
    color: var(--color-ink);
  }
  .note-title:hover {
    color: var(--color-bubblegum-deep);
    text-decoration: underline wavy;
  }
</style>
