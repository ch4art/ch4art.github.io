---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { withBase } from '../../lib/withBase';

const works = (await getCollection('works')).sort((a, b) => a.data.order - b.data.order);
---

<BaseLayout title="作品集">
  <h1 class="sticker title-pop text-5xl mb-3" data-text="作品集">作品集 🎨</h1>
  <p class="text-ink/70 font-bold mb-8">點任一個作品,進去就能 360° 轉一轉、放大看細節!</p>

  <div class="grid gap-6" style="grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));">
    {
      works.map((w) => (
        <a href={withBase(`portfolio/${w.id}`)} class="card-pop anim-wiggle p-3 block">
          <img
            src={withBase(`works/${w.data.thumb}`)}
            alt={w.data.title}
            loading="lazy"
            width="300"
            height="300"
            class="w-full rounded-blob"
            style="aspect-ratio:1/1;object-fit:contain;background:#FFF0F6;"
          />
          <p class="font-display text-center mt-3 text-lg text-ink">{w.data.title}</p>
        </a>
      ))
    }
  </div>
</BaseLayout>
