---
import BaseLayout from '../layouts/BaseLayout.astro';
import ModelViewer from '../components/three/ModelViewer.tsx';
import { modelUrl } from '../lib/model';

const models = [
  { src: modelUrl('duck.glb'), env: 'city', title: '小鴨 Duck' },
  { src: modelUrl('avocado.glb'), env: 'sunset', title: '酪梨 Avocado' },
  { src: modelUrl('toycar.glb'), env: 'park', title: '玩具車 Toy Car' },
] as const;
---

<BaseLayout title="作品集">
  <h1 class="sticker title-pop text-5xl mb-3">作品集 🎨</h1>
  <p class="text-ink/70 font-bold mb-8">這些是範例模型,之後換成你自己的作品就好 😊</p>

  <div class="grid gap-6" style="grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));">
    {
      models.map((m) => (
        <figure class="card-pop anim-wiggle p-3">
          <ModelViewer client:only="react" src={m.src} environment={m.env} height={300} />
          <figcaption class="font-display text-center mt-3 text-lg text-ink">{m.title}</figcaption>
        </figure>
      ))
    }
  </div>
</BaseLayout>
