---
import { ClientRouter } from 'astro:transitions';
import '@fontsource-variable/fredoka';
import '@fontsource-variable/baloo-2';
import '@fontsource-variable/nunito';
// 圓胖中文標題字型(粉圓 Huninn)— 只載繁中子集,讓中文標題跟英文一樣可愛。
import '@fontsource/huninn/chinese-traditional-400.css';
import '@fontsource/huninn/latin-400.css';
import '../styles/global.css';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import DecorField from '../components/decor/DecorField.astro';

interface Props {
  title?: string;
  description?: string;
  /** 文章可帶 heroImage 當 og:image(絕對 URL 由這裡組) */
  ogImage?: string;
  /** 滿幅頁(首頁 hero)把 main 的盒寬交給頁面自己控制 */
  fullBleed?: boolean;
}

const {
  title = 'ch4art — 可愛的畫畫與 3D 模型',
  description = '可愛的藝術與 3D 建模作品集 + 部落格',
  ogImage,
  fullBleed = false,
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImageUrl = ogImage ? new URL(ogImage, Astro.site) : new URL('og.png', Astro.site);
---

<!doctype html>
<html lang="zh-Hant">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <!-- favicon is a public/ file → needs the base prefix -->
    <link rel="icon" type="image/svg+xml" href={`${import.meta.env.BASE_URL}favicon.svg`} />
    <link
      rel="alternate"
      type="application/rss+xml"
      title="ch4art 部落格"
      href={new URL('rss.xml', Astro.site)}
    />

    <!-- Open Graph / Twitter (社群分享預覽) -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:site_name" content="ch4art" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    <title>{title}</title>
    <ClientRouter />
  </head>
  <body class="bg-cream text-ink font-body flex min-h-screen flex-col">
    <!-- 視差裝飾層跨頁存活(persist),換頁不重生形狀 -->
    <div transition:persist="decor-field">
      <DecorField />
    </div>
    <Nav />
    {
      fullBleed ? (
        <main class="relative z-10 flex-1">
          <slot />
        </main>
      ) : (
        <main class="relative z-10 mx-auto w-full max-w-5xl flex-1 px-4 py-8">
          <slot />
        </main>
      )
    }
    <Footer />

    <script>
      // 全站 GSAP 動效(生命週期由 motion.ts 自己管理)
      import '../scripts/motion';
    </script>

    <script>
      // 點擊回饋:在點擊處迸出小星星(尊重減少動態偏好;document 層級,
      // 跨 ClientRouter 換頁仍有效,只綁一次)
      function bindSparkles() {
        const w = window as unknown as Record<string, unknown>;
        if (w.__sparkBound) return;
        w.__sparkBound = true;
        if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

        const COLORS = [
          '#FF9FCB',
          '#F2569E',
          '#FF6FAE',
          '#9AD3FF',
          '#FFE27A',
          '#FFC83D',
          '#9B6DFF',
          '#5FE0DA',
        ];
        const GLYPHS = ['✦', '✧', '●', '★'];

        document.addEventListener('pointerdown', (e) => {
          for (let i = 0; i < 12; i++) {
            const s = document.createElement('span');
            s.className = 'spark';
            s.textContent = GLYPHS[Math.floor(Math.random() * GLYPHS.length)];
            s.style.color = COLORS[Math.floor(Math.random() * COLORS.length)];
            s.style.left = `${e.clientX}px`;
            s.style.top = `${e.clientY}px`;
            s.style.fontSize = `${12 + Math.random() * 10}px`;
            s.style.animationDuration = `${0.5 + Math.random() * 0.4}s`;
            const ang = Math.random() * Math.PI * 2;
            const dist = 30 + Math.random() * 55;
            s.style.setProperty('--dx', `${Math.cos(ang) * dist}px`);
            s.style.setProperty('--dy', `${Math.sin(ang) * dist}px`);
            s.addEventListener('animationend', () => s.remove());
            document.body.appendChild(s);
          }
        });
      }
      bindSparkles();
    </script>
  </body>
</html>
