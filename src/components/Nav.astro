---
import { withBase } from '../lib/withBase';

const links = [
  { href: withBase(''), label: '首頁', cls: 'bg-bubblegum' },
  { href: withBase('portfolio'), label: '作品集', cls: 'bg-skyberry' },
  { href: withBase('blog'), label: '部落格', cls: 'bg-butter' },
];

const current = Astro.url.pathname.replace(/\/$/, '');
---

<nav class="relative z-10 flex flex-wrap gap-4 justify-center py-6">
  {
    links.map((l) => {
      const isActive = current === l.href.replace(/\/$/, '');
      return (
        <a
          href={l.href}
          aria-current={isActive ? 'page' : undefined}
          class:list={[
            'btn-pop anim-wiggle text-lg px-6 py-2.5 text-ink',
            l.cls,
            isActive && '-translate-y-1',
          ]}
        >
          {l.label}
        </a>
      );
    })
  }
</nav>
