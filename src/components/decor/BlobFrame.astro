---
// 圓角方框:粗框 + hard shadow(hero 模型 / about 頭像)。
// 使用者指定:全站不用不規則形,一律規則圓角方形。
interface Props {
  color?: string; // 內底色
  class?: string;
}
const { color = 'var(--color-pink-mist)', class: cls = '' } = Astro.props;
---

<div class={`blob-frame ${cls}`} style={`--bf-c:${color};`}>
  <slot />
</div>

<style>
  .blob-frame {
    position: relative;
    background: var(--bf-c);
    border: 4px solid var(--color-outline);
    border-radius: 2rem;
    box-shadow: var(--shadow-pop-lg);
    overflow: hidden;
  }
</style>
