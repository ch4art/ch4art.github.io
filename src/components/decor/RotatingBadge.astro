---
// 環形旋轉文字徽章(hero 模型角落):文字沿圓path慢轉,中心放 emoji/圖。
interface Props {
  text: string;
  size?: number;
  color?: string; // 文字色
  class?: string;
}
const { text, size = 120, color = 'var(--color-bubblegum-deep)', class: cls = '' } = Astro.props;
const repeated = `${text} • `;
---

<span class={`rot-badge ${cls}`} style={`width:${size}px;height:${size}px;`} aria-hidden="true">
  <svg viewBox="0 0 100 100" class="anim-spin">
    <defs>
      <path id={`rb-${text.length}-${size}`} d="M 50 50 m -38 0 a 38 38 0 1 1 76 0 a 38 38 0 1 1 -76 0"></path>
    </defs>
    <text style={`fill:${color};`}>
      <textPath href={`#rb-${text.length}-${size}`}>{repeated}{repeated}</textPath>
    </text>
  </svg>
  <span class="rot-center"><slot>✦</slot></span>
</span>

<style>
  .rot-badge {
    position: relative;
    display: inline-grid;
    place-items: center;
  }
  .rot-badge svg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: visible;
  }
  .rot-badge text {
    font-family: var(--font-label);
    font-size: 10.5px;
    font-weight: 700;
    letter-spacing: 0.12em;
  }
  .rot-center {
    font-size: 1.4rem;
  }
</style>
