---
// 拍立得相框:白色貼紙環邊 + 底部標題條 + 可選紙膠帶。
// slot = 圖片(<Image> 或 <img>);caption = 底部小字。
import WashiTape from './WashiTape.astro';

interface Props {
  caption?: string;
  tilt?: number;
  tape?: boolean;
  tapeColor?: string;
  class?: string;
}
const { caption, tilt = 0, tape = true, tapeColor = 'var(--color-mint)', class: cls = '' } = Astro.props;
---

<figure class={`polaroid ${cls}`} style={`--pf-tilt:${tilt}deg;`}>
  {tape && <WashiTape color={tapeColor} tilt={tilt - 6} />}
  <div class="polaroid-img">
    <slot />
  </div>
  {caption && <figcaption class="polaroid-cap">{caption}</figcaption>}
</figure>

<style>
  .polaroid {
    position: relative;
    background: #fff;
    border: 3px solid var(--color-outline);
    border-radius: 14px;
    box-shadow: var(--shadow-pop);
    padding: 10px 10px 8px;
    transform: rotate(var(--pf-tilt));
    transition:
      transform 0.25s cubic-bezier(0.34, 1.56, 0.64, 1),
      box-shadow 0.25s ease;
  }
  /* hover:「扶正歪掉的照片」+ 升起 */
  @media (hover: hover) {
    .polaroid:hover {
      transform: rotate(0deg) translate(-4px, -6px);
      box-shadow: var(--shadow-pop-lg);
      z-index: 3;
    }
  }
  .polaroid-img {
    border-radius: 8px;
    overflow: hidden;
    background: var(--color-pink-mist);
  }
  .polaroid-img :global(img) {
    display: block;
    width: 100%;
    height: auto;
  }
  .polaroid-cap {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 0.92rem;
    color: var(--color-ink);
    text-align: center;
    padding-top: 8px;
  }
</style>
