---
// 網站吉祥物:可愛老鼠 🐭(品牌簽名角色,首頁/頁尾/404 出沒)。
// 純幾何 SVG(圓形堆疊),currentColor 不適用 — 配色固定走品牌 token。
// mood: 'happy'(預設)| 'cry'(404)
interface Props {
  mood?: 'happy' | 'cry';
  size?: number;
  class?: string;
}
const { mood = 'happy', size = 96, class: cls = '' } = Astro.props;
---

<svg
  class={cls}
  width={size}
  height={size}
  viewBox="0 0 100 100"
  fill="none"
  aria-hidden="true"
>
  <!-- 耳朵(在頭後面) -->
  <circle cx="27" cy="24" r="15" fill="#fff" stroke="var(--color-outline)" stroke-width="4"></circle>
  <circle cx="73" cy="24" r="15" fill="#fff" stroke="var(--color-outline)" stroke-width="4"></circle>
  <circle cx="27" cy="24" r="7.5" fill="var(--color-bubblegum)"></circle>
  <circle cx="73" cy="24" r="7.5" fill="var(--color-bubblegum)"></circle>

  <!-- 頭 -->
  <ellipse cx="50" cy="60" rx="32" ry="28" fill="#fff" stroke="var(--color-outline)" stroke-width="4"></ellipse>

  <!-- 鬍鬚 -->
  <g stroke="var(--color-outline)" stroke-width="2.5" stroke-linecap="round">
    <line x1="10" y1="58" x2="22" y2="60"></line>
    <line x1="10" y1="68" x2="22" y2="67"></line>
    <line x1="90" y1="58" x2="78" y2="60"></line>
    <line x1="90" y1="68" x2="78" y2="67"></line>
  </g>

  <!-- 腮紅 -->
  <ellipse cx="30" cy="67" rx="6" ry="3.5" fill="var(--color-bubblegum)" opacity="0.65"></ellipse>
  <ellipse cx="70" cy="67" rx="6" ry="3.5" fill="var(--color-bubblegum)" opacity="0.65"></ellipse>

  {
    mood === 'happy' ? (
      <>
        <circle cx="38" cy="56" r="4" fill="var(--color-outline)" />
        <circle cx="62" cy="56" r="4" fill="var(--color-outline)" />
        <path d="M44 70 Q50 76 56 70" stroke="var(--color-outline)" stroke-width="3" stroke-linecap="round" fill="none" />
      </>
    ) : (
      <>
        {/* 哭哭:閉眼下彎 + 藍色淚滴 + 嘴角下垂 */}
        <path d="M33 55 Q38 59 43 55" stroke="var(--color-outline)" stroke-width="3" stroke-linecap="round" fill="none" />
        <path d="M57 55 Q62 59 67 55" stroke="var(--color-outline)" stroke-width="3" stroke-linecap="round" fill="none" />
        <path d="M38 61 C38 65 35 66.5 35 69 a3 3 0 0 0 6 0 C41 66.5 38 65 38 61 Z" fill="var(--color-skyberry)" />
        <path d="M62 61 C62 65 59 66.5 59 69 a3 3 0 0 0 6 0 C65 66.5 62 65 62 61 Z" fill="var(--color-skyberry)" />
        <path d="M44 74 Q50 69 56 74" stroke="var(--color-outline)" stroke-width="3" stroke-linecap="round" fill="none" />
      </>
    )
  }

  <!-- 鼻子(蓋在嘴巴上緣) -->
  <ellipse cx="50" cy="64" rx="4.5" ry="3.5" fill="var(--color-bubblegum-deep)"></ellipse>
</svg>
